{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aseprite Installer",
  "version": "0.1.0",
  "identifier": "dev.fmhun.aseprite-installer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aseprite Installer",
        "width": 1080,
        "height": 780,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Build Aseprite from official sources",
    "longDescription": "Unofficial utility that compiles and manages a personal Aseprite installation from official source releases.",
    "copyright": "Copyright © 2026 fmhun",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "15.2",
      "signingIdentity": "-"
    }
  }
}
