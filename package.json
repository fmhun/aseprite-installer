{
  "name": "aseprite-installer",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:site": "vite --config vite.site.config.ts",
    "build": "tsc -b && vite build",
    "build:site": "tsc -p site/tsconfig.json --pretty false && vite build --config vite.site.config.ts && vite build --config vite.site.config.ts --ssr src/entry-server.tsx --outDir ../dist-site-ssr && node scripts/prerender-site.mjs && node scripts/validate-site-seo.mjs",
    "test": "vitest run",
    "test:apt": "bash .github/scripts/test-apt-repository.sh",
    "test:site": "vitest run --config vite.site.config.ts",
    "test:seo": "node scripts/validate-site-seo.mjs",
    "test:watch": "vitest",
    "lint": "tsc -b --pretty false",
    "preview:site": "vite preview --config vite.site.config.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
